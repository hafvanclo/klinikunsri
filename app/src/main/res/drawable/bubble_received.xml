<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color for the received message bubble -->
    <solid android:color="#E0E0E0" /> <!-- Ganti dengan warna yang sesuai untuk pesan diterima -->

    <!-- Rounded corners -->
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp"
        android:bottomLeftRadius="16dp"
        android:bottomRightRadius="0dp" />

    <!-- Optional padding -->
    <padding
        android:left="12dp"
        android:top="8dp"
        android:right="12dp"
        android:bottom="8dp" />

</shape>
