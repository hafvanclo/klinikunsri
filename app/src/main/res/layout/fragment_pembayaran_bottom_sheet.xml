<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:background="@drawable/rounded_corners"
    android:padding="16dp">

    <!-- Metode Pembayaran -->
    <TextView
        android:id="@+id/tvMetodePembayaran"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Metode Pembayaran"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="20sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#8C8994"/>

    <!-- Radio Button untuk BPJS -->
    <RadioGroup
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_marginVertical="10dp"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rbBpjs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BPJS (GRATIS)"
            android:buttonTint="@color/radio_button_color"
            android:textColor="@color/radio_button_color"/>
    </RadioGroup>




    <!-- Total Pesanan -->
    <TextView
        android:id="@+id/tvpesanan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pesanan"
        android:gravity="start"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:layout_marginTop="10dp"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/namaObat"
            android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paracetamol 500mg"
        android:gravity="start"
        android:textStyle="normal"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"/>

        <TextView
            android:id="@+id/qty"
            android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="2x"
        android:gravity="start"
        android:textStyle="normal"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"/>

        <TextView
            android:id="@+id/harga"
            android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Rp. 6000"
        android:gravity="start"
        android:textStyle="normal"
        android:textColor="@color/gray"
        android:textSize="14sp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView

            android:layout_width="wrap_content"
        android:layout_height="wrap_content"
